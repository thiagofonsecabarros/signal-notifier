[Unit]
Description=Stock Notifier 15-minute snapshot scan cycle
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=stocknotifier
Group=stocknotifier
WorkingDirectory=/opt/stock-notifier
EnvironmentFile=/opt/stock-notifier/.env
ExecStart=/opt/stock-notifier/.venv/bin/stock-notifier run-scan-cycle --benchmark
Nice=10
NoNewPrivileges=true
PrivateTmp=true
