[Unit]
Description=Stock Notifier scheduled services runner
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/stock-notifier
EnvironmentFile=/opt/stock-notifier/.env
ExecStart=/opt/stock-notifier/.venv/bin/stock-notifier services-run-due
Nice=10
NoNewPrivileges=true
PrivateTmp=true
