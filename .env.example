# Required: create at https://massive.com/dashboard/api-keys
MASSIVE_API_KEY=your_massive_api_key_here

# Runtime paths and API behavior
DB_PATH=/opt/stock-notifier/data/stock_notifier.db
SYMBOLS_PATH=/opt/stock-notifier/config/symbols.txt
MASSIVE_BASE_URL=https://api.massive.com
MASSIVE_REQUESTS_PER_MINUTE=5
MASSIVE_HTTP_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO

# Dashboard (used by deploy/stock-notifier-dashboard.service)
DASHBOARD_ADDRESS=127.0.0.1
DASHBOARD_PORT=8501
